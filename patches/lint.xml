        <!-- Public at API 29/30 but present as @hide public constructors on API 22: reached
             on API 22 through 0010's `?: NetworkCapabilities()` and `?: LinkProperties()`
             fallbacks in NetworkChangeCallback.onAvailable. -->
        <ignore regexp="android\.net\.(NetworkCapabilities|LinkProperties)\(\)" />
    </issue>
</lint>
