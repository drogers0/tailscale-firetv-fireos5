   override fun bindSocketToNetwork(fd: Int): Boolean {
+    // Network.bindSocket(FileDescriptor) is API 23+. VpnService.protect(fd) keeps the socket
+    // out of the tunnel instead; equivalent on a single uplink (gap in docs/STATUS.md).
+    if (Build.VERSION.SDK_INT < Build.VERSION_CODES.M) {
+      val svc =
+          IPNService.runningInstance
+              ?: run {
+                TSLog.d(TAG, "bindSocketToActiveNetwork: no running IPNService; noop")
+                return false
+              }
+      val ok = svc.protect(fd)
+      TSLog.d(TAG, "bindSocketToActiveNetwork: VpnService.protect(fd=$fd) -> $ok")
+      return ok
+    }
+
     val net =
         NetworkChangeCallback.cachedDefaultNetwork
             ?: run {
