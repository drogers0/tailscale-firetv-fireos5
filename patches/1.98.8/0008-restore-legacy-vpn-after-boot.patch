@@ -0,0 +1,28 @@
+package com.tailscale.ipn;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class VpnRestoreGateTest {
+    @Test public void resumesSavedConnectionWithConsent() {
+        VpnRestoreGate gate = new VpnRestoreGate();
+        int request = gate.beginRequest();
+        assertTrue(gate.shouldRestore(request, true, true));
+    }
+    @Test public void preservesManualDisconnect() {
+        VpnRestoreGate gate = new VpnRestoreGate();
+        int request = gate.beginRequest();
+        assertFalse(gate.shouldRestore(request, false, true));
+    }
+    @Test public void refusesRevokedConsent() {
+        VpnRestoreGate gate = new VpnRestoreGate();
+        int request = gate.beginRequest();
+        assertFalse(gate.shouldRestore(request, true, false));
+    }
+    @Test public void laterCommandInvalidatesPendingRecovery() {
+        VpnRestoreGate gate = new VpnRestoreGate();
+        int recovery = gate.beginRequest();
+        gate.beginRequest();
+        assertFalse(gate.shouldRestore(recovery, true, true));
+    }
+}
