diff --git a/android/src/main/java/com/tailscale/ipn/VpnRestoreGate.java b/android/src/main/java/com/tailscale/ipn/VpnRestoreGate.java
new file mode 100644
index 0000000..8424cbb
--- /dev/null
+++ b/android/src/main/java/com/tailscale/ipn/VpnRestoreGate.java
@@ -0,0 +1,16 @@
+// Copyright (c) Tailscale Inc & AUTHORS
+// SPDX-License-Identifier: BSD-3-Clause
+package com.tailscale.ipn;
+
+/** Main-thread gate for asynchronous restoration of a saved VPN connection. */
+final class VpnRestoreGate {
+    private int generation;
+
+    int beginRequest() { return ++generation; }
+
+    boolean isCurrent(int request) { return request == generation; }
+
+    boolean shouldRestore(int request, boolean wantRunning, boolean prepared) {
+        return isCurrent(request) && wantRunning && prepared;
+    }
+}
