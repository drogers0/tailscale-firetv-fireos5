+  /**
+   * On API < 23 there is no Network.bindSocket(FileDescriptor), and on this class of device
+   * the NetworkRequest callback never fires, so cachedDefaultNetwork stays null forever.
+   * Both leave Tailscale's own sockets inside its own tunnel, which breaks DERP and leaves
+   * the node unreachable.
+   *
+   * VpnService.protect(fd) (API 14) is the platform's mechanism for exactly this: it keeps a
+   * socket outside the VPN. It is weaker than bindSocket — it excludes the tunnel rather than
+   * pinning to a chosen network — but on a single-uplink device that is equivalent.
+   */
+  private fun protectSocketFallback(fd: Int, why: String): Boolean {
+    val svc = IPNService.runningInstance
+    if (svc == null) {
+      TSLog.d(TAG, "bindSocketToActiveNetwork: $why, and no running IPNService; noop")
+      return false
+    }
+    val ok = svc.protect(fd)
+    TSLog.d(TAG, "bindSocketToActiveNetwork: $why; VpnService.protect(fd=$fd) -> $ok")
+    return ok
+  }
