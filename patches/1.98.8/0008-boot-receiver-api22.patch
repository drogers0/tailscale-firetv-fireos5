+// Copyright (c) Tailscale Inc & AUTHORS
+// SPDX-License-Identifier: BSD-3-Clause
+package com.tailscale.ipn
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.net.VpnService
+import android.os.Build
+import com.tailscale.ipn.ui.localapi.Client
+
+// Reconnects the VPN after a reboot on API < 24.
+//
+// Upstream declares no BOOT_COMPLETED receiver: it relies on Android's always-on
+// VPN to start IPNService at boot, and always-on VPN is API 24+. Below that nothing
+// starts the tunnel, so it stays down until the app is opened.
+//
+// Only reconnect if the user left it connected (WantRunning) and VPN consent is
+// still granted; a manual disconnect stays disconnected. startVPN() is the same
+// path the UI's connect button takes. On API 24+ this is a no-op and always-on
+// VPN stays in charge.
+class BootReceiver : BroadcastReceiver() {
+  override fun onReceive(context: Context, intent: Intent) {
+    if (intent.action != Intent.ACTION_BOOT_COMPLETED ||
+        Build.VERSION.SDK_INT >= Build.VERSION_CODES.N ||
+        VpnService.prepare(context) != null) {
+      return
+    }
+    val app = App.get()
+    val pending = goAsync()
+    Client(app.applicationScope).prefs { result ->
+      try {
+        if (result.getOrNull()?.WantRunning == true) app.startVPN()
+      } finally {
+        pending.finish()
+      }
+    }
+  }
+}
